<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FoodWasteMod</RootNamespace>
    <AssemblyName>FoodWasteMod</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\Assemblies\</OutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Nothing here ships but the one assembly; the reference packages are build-time only. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Point this at your local RimWorld install (folder containing RimWorldWin64_Data). -->
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <HasLocalRimWorld Condition="Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')">true</HasLocalRimWorld>
  </PropertyGroup>

  <!--
    Two ways to resolve RimWorld's types, picked automatically.

    A real install is preferred when one is there: it is the exact build you are going to run
    against, so a mismatch cannot hide. When there is no install - a CI runner, a container, a
    machine that owns the game on a different drive - it falls back to Krafs.Rimworld.Ref, the
    public reference-assembly package modders use for exactly this. Reference assemblies carry
    signatures and no IL, so this is a type check rather than a substitute for running the game.
  -->
  <ItemGroup Condition="'$(HasLocalRimWorld)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(HasLocalRimWorld)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" />
  </ItemGroup>

  <!-- net472 does not exist as a targeting pack off Windows; this package supplies it. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
