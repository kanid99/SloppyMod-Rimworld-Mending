<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>SloppyFW_SpoiledFood</defName>
    <label>spoiled food</label>
    <description>A reeking heap of food that went over. Mould, slime and whatever the mould is eating. It is well past anything a colonist or an animal would touch, but the bulk of it is still organic matter, and organic matter can be digested into chemfuel, composted into biopacks, or simply sealed into a wastepack and taken away.\n\nLeft alone it keeps rotting and is gone within a few days. Cold stops that, so a pile worth processing needs to be kept cold like any other food.</description>

    <graphicData>
      <texPath>Things/Item/Resource/SpoiledFood</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>

    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <Beauty>-30</Beauty>
      <MarketValue>0.5</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>6</DeteriorationRate>
    </statBases>

    <stackLimit>75</stackLimit>

    <!-- CompRottable needs a ticker. Rare is what vanilla food uses; the comp works on tick
         intervals, so it costs nothing to run a warehouse of this. -->
    <tickerType>Rare</tickerType>

    <thingCategories>
      <li>SloppyFW_FoodWaste</li>
    </thingCategories>

    <comps>
      <!--
        The single most important line in this mod. Spoiled food rots away on its own, so a player
        who does not want the feature is not taxed by it: ignore the piles and in four days they
        are gone. Without this, every colony slowly accumulates a permanent midden and the mod
        becomes a hauling chore rather than an option.

        It is temperature-gated like all rot, which gives the intended behaviour for free: keep it
        cold if you mean to process it, leave it in the sun if you do not.
      -->
      <li Class="CompProperties_Rottable">
        <daysToRotStart>4</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>

      <!-- Matching Vanilla Recycling Expanded's house style for its own unpleasant items. -->
      <li Class="CompProperties_GasOnDamage">
        <type>RotStink</type>
        <damageFactor>3</damageFactor>
        <useStackCountAsFactor>true</useStackCountAsFactor>
      </li>
    </comps>
  </ThingDef>

</Defs>
