<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    BALANCE NOTE, since every number below is a judgement call.

    One unit of spoiled food is one nutrition of food that went bad (see SpoilageYield.cs). Vanilla
    refines 35 raw food - 1.75 nutrition - into 35 chemfuel, so fresh organics are worth about 20
    chemfuel per nutrition. This recipe pays 2 per nutrition. Rotting your stores on purpose to
    make fuel is therefore about ten times worse than refining them fresh, which is the point:
    spoilage has to stay a loss, and these recipes only decide how total a loss it is.

    The two recycling-bench routes are priced against that same scale, and against Vanilla
    Recycling Expanded's own chain, where 3 wastepacks yield 1 biopack as a byproduct.
  -->

  <!--
    The early exit. A biofuel refinery already eats raw organic matter, and spoiled food is raw
    organic matter, so this needs no new building and no research beyond the refinery's own.
    It matters that this is available before the recycling research: without it a young colony
    just watches spoiled food pile up with nothing to do about it.
  -->
  <RecipeDef>
    <defName>SloppyFW_Make_ChemfuelFromSpoiledFood</defName>
    <label>make chemfuel from spoiled food</label>
    <description>Digest spoiled food into chemfuel. Rot has already consumed most of the usable energy, so this recovers a fraction of what refining the food before it turned would have.</description>
    <jobString>Refining spoiled food into chemfuel.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>1800</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>SloppyFW_SpoiledFood</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SloppyFW_SpoiledFood</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Chemfuel>20</Chemfuel>
    </products>
    <recipeUsers>
      <li>BiofuelRefinery</li>
    </recipeUsers>
    <researchPrerequisite>BiofuelRefining</researchPrerequisite>
    <displayPriority>600</displayPriority>
  </RecipeDef>

  <!--
    The intended destination. Reclaimed biopacks improve soil fertility when a stack of five is
    left to dissolve on ordinary soil, which makes food waste to compost to better soil the loop
    this mod exists to close. Before this, biopacks had no deliberate source at all - the only
    way to get one in Vanilla Recycling Expanded is as a byproduct of the wastepack-to-chempack
    recipe, one per three wastepacks.
  -->
  <RecipeDef>
    <defName>SloppyFW_Compost_SpoiledFoodIntoBiopack</defName>
    <label>compost spoiled food into reclaimed biopacks</label>
    <description>Break spoiled food down into stable bio-material and heat-seal it into a reclaimed biopack. Most of the mass is lost to the process, but what survives is the nutrient-rich material that improves soil where it dissolves.</description>
    <jobString>Composting spoiled food into reclaimed biopacks.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>1200</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>SloppyFW_SpoiledFood</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SloppyFW_SpoiledFood</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <VRecyclingE_ReclaimedBiopack>1</VRecyclingE_ReclaimedBiopack>
    </products>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>VRecyclingE_RecyclingWorkbench</li>
      <li>VRecyclingE_ElectricRecyclingWorkbench</li>
    </recipeUsers>
    <researchPrerequisite>VRecyclingE_BasicRecycling</researchPrerequisite>
    <displayPriority>601</displayPriority>
  </RecipeDef>

  <!--
    The disposal exit, and the on-ramp to the rest of the recycling tree. Cheaper per unit than
    composting on purpose: what you get is a wastepack, which is a liability - it pollutes if it
    dissolves - so the cheaper rate is not a better deal, just a faster way to make the pile
    somebody else's problem. Feeds atomizers, traders, and every Vanilla Recycling Expanded
    recipe that starts from a wastepack.
  -->
  <RecipeDef>
    <defName>SloppyFW_Bale_SpoiledFoodIntoWastepack</defName>
    <label>seal spoiled food into wastepacks</label>
    <description>Compact spoiled food and heat-seal it into a standard wastepack. Nothing is recovered - this is disposal - but a sealed wastepack can be atomized, sold, dumped, or fed into the recycling chain, and it will not stink up the colony in the meantime.</description>
    <jobString>Sealing spoiled food into wastepacks.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>900</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>SloppyFW_SpoiledFood</li>
          </thingDefs>
        </filter>
        <count>6</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SloppyFW_SpoiledFood</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Wastepack>1</Wastepack>
    </products>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>VRecyclingE_RecyclingWorkbench</li>
      <li>VRecyclingE_ElectricRecyclingWorkbench</li>
    </recipeUsers>
    <researchPrerequisite>VRecyclingE_BasicRecycling</researchPrerequisite>
    <displayPriority>602</displayPriority>
  </RecipeDef>

</Defs>
