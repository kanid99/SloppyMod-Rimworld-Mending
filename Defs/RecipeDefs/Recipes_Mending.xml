<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    workSkill drives the bill's "Allowed skill range" slider, which is what lets you keep
    clumsy pawns off a bill. Dialog_BillConfig only draws it when recipe.workSkill is set,
    and Bill.PawnAllowedToStartAnew only enforces allowedSkillRange under the same condition
    (both confirmed by decompiling them), so leaving it unset - as this did - silently means
    no slider and no gate.

    Both recipes use Crafting, because RimWorld has no Smithing SKILL - Smithing is a
    WorkTypeDef only, and smithing work trains Crafting (confirmed against SkillDefOf, which
    lists no such skill). Naming it here resolved to null, which is exactly the same as
    leaving workSkill unset: no slider on the mend weapon bill, and no gate.

    It costs nothing here: vanilla's per-recipe XP is granted by Toils_Recipe.DoRecipeWork,
    which JobDriver_DoMend replaces wholesale, so setting workSkill adds no second XP source.
    XP is still granted once, by RecipeWorker_Mend, against the mended item's OWN
    recipeMaker.workSkill - which for vanilla weapons and apparel alike is Crafting, so the
    skill the bill gates on and the skill the repair trains are the same one.
  -->

  <RecipeDef>
    <defName>MendApparel</defName>
    <label>mend apparel</label>
    <description>Repair a damaged piece of apparel. Material and work-time costs scale dynamically with how much HP is missing.</description>
    <jobString>Mending apparel.</jobString>
    <workSkill>Crafting</workSkill>
    <!-- Both mend recipes sit on the same benches but belong to different work types. Without
         this, WorkGiver_Mend offers every bill to both of its work givers, so a colonist allowed
         only Smithing would take apparel bills, and one allowed only Crafting would take weapons. -->
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <workerClass>MendingMod.RecipeWorker_Mend</workerClass>
    <workAmount>300</workAmount>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Apparel</li>
          </categories>
          <allowedHitPointsPercents>0~0.99</allowedHitPointsPercents>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Apparel</li>
      </categories>
      <allowedHitPointsPercents>0~0.99</allowedHitPointsPercents>
    </fixedIngredientFilter>
    <products />
    <recipeUsers>
      <li>TableMending_Manual</li>
      <li>TableMending_Electric</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef>
    <defName>MendWeapon</defName>
    <label>mend weapon</label>
    <description>Repair a damaged weapon. Material and work-time costs scale dynamically with how much HP is missing.</description>
    <jobString>Mending weapon.</jobString>
    <workSkill>Crafting</workSkill>
    <requiredGiverWorkType>Smithing</requiredGiverWorkType>
    <workerClass>MendingMod.RecipeWorker_Mend</workerClass>
    <workAmount>300</workAmount>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Weapons</li>
          </categories>
          <allowedHitPointsPercents>0~0.99</allowedHitPointsPercents>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Weapons</li>
      </categories>
      <allowedHitPointsPercents>0~0.99</allowedHitPointsPercents>
    </fixedIngredientFilter>
    <products />
    <recipeUsers>
      <li>TableMending_Manual</li>
      <li>TableMending_Electric</li>
    </recipeUsers>
  </RecipeDef>

</Defs>
