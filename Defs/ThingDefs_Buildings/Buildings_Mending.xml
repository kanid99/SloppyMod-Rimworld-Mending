<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>TableMending_Manual</defName>
    <label>mending table</label>
    <description>A simple, unpowered workbench for repairing worn apparel and weapons by hand.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableMending_Manual</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- drawSize deliberately equals size: the textures are authored at the footprint's exact
           3:1 aspect, so the art lands inside its own cells with no overhang. -->
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <costList>
      <WoodLog>60</WoodLog>
      <Steel>20</Steel>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <!-- Without hasInteractionCell, ThingUtility.InteractionCellWhenAt has no work spot to
         return for a multi-cell building, so the game draws no work-spot circle and the pawn
         ends up standing wherever it can touch the bench instead of in front of it. -->
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Flammability>1.0</Flammability>
      <WorkTableWorkSpeedFactor>0.25</WorkTableWorkSpeedFactor>
      <WorkTableEfficiencyFactor>1.0</WorkTableEfficiencyFactor>
    </statBases>
    <researchPrerequisites>
      <li>BasicMending</li>
    </researchPrerequisites>
    <comps>
      <li Class="MendingMod.CompProperties_MenderWasteBuffer">
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <toxicWasteDefName>Wastepack</toxicWasteDefName>
        <trashWasteDefNames>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>TableMending_Electric</defName>
    <label>electric mending table</label>
    <description>A powered mending table. Repairs apparel and weapons at full speed.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableMending_Electric</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <!-- Without hasInteractionCell, ThingUtility.InteractionCellWhenAt has no work spot to
         return for a multi-cell building, so the game draws no work-spot circle and the pawn
         ends up standing wherever it can touch the bench instead of in front of it. -->
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Flammability>0.5</Flammability>
      <WorkTableWorkSpeedFactor>1.0</WorkTableWorkSpeedFactor>
      <WorkTableEfficiencyFactor>1.0</WorkTableEfficiencyFactor>
    </statBases>
    <researchPrerequisites>
      <li>ElectricMending</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="MendingMod.CompProperties_MenderWasteBuffer">
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <toxicWasteDefName>Wastepack</toxicWasteDefName>
        <trashWasteDefNames>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>AutomatedMender</defName>
    <label>automated mender</label>
    <description>An industrial repair line that mends worn gear with no pawn labor, working as a skill 10 mender. Select it to see its spots: gear and materials feed in along the back, and finished items come out of the single port at the front. Put one damaged weapon or piece of apparel on the cyan spot, repair materials on any of the eight green spots, and collect repaired gear from the yellow spot. Every spot accepts loose items on the ground or any storage building sitting on it. To feed it from a conveyor belt, build a mending feed port on the spot and point the belt at that - a belt aimed straight at the machine has nowhere to unload and will stall.</description>
    <thingClass>MendingMod.Building_AutomatedMender</thingClass>
    <!-- Without this the def defaults to TickerType.Never and Thing.DoTick never calls Tick(),
         so the mender's whole state machine (and its power draw) silently never runs. -->
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Production/AutomatedMender</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(5,3)</size>
    <costList>
      <Steel>250</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <surfaceType>Item</surfaceType>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <statBases>
      <Mass>40</Mass>
      <Beauty>-8</Beauty>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>0.3</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>AutomatedMending</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="MendingMod.CompProperties_MenderWasteBuffer">
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <toxicWasteDefName>Wastepack</toxicWasteDefName>
        <trashWasteDefNames>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
      </li>
    </comps>
  </ThingDef>

</Defs>
