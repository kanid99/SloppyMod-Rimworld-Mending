<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>TableMending_Manual</defName>
    <label>mending table</label>
    <description>A simple, unpowered workbench for repairing worn apparel and weapons by hand.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableMending_Manual</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1.29)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <costList>
      <WoodLog>60</WoodLog>
      <Steel>20</Steel>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Flammability>1.0</Flammability>
      <WorkTableWorkSpeedFactor>0.25</WorkTableWorkSpeedFactor>
      <WorkTableEfficiencyFactor>1.0</WorkTableEfficiencyFactor>
    </statBases>
    <researchPrerequisites>
      <li>BasicMending</li>
    </researchPrerequisites>
    <comps>
      <li Class="MendingMod.CompProperties_MenderWasteBuffer">
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <toxicWasteDefName>Wastepack</toxicWasteDefName>
        <trashWasteDefNames>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>TableMending_Electric</defName>
    <label>electric mending table</label>
    <description>A powered mending table. Repairs apparel and weapons at full speed.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableMending_Electric</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1.29)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Flammability>0.5</Flammability>
      <WorkTableWorkSpeedFactor>1.0</WorkTableWorkSpeedFactor>
      <WorkTableEfficiencyFactor>1.0</WorkTableEfficiencyFactor>
    </statBases>
    <researchPrerequisites>
      <li>ElectricMending</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="MendingMod.CompProperties_MenderWasteBuffer">
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <toxicWasteDefName>Wastepack</toxicWasteDefName>
        <trashWasteDefNames>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>AutomatedMender</defName>
    <label>automated mender</label>
    <description>A fully automated mending station. A fully automated mending station, working as a skill 10 mender with no pawn labor. Select it to see its spots: put one damaged weapon or piece of apparel on the cyan spot, repair materials on the green spots, and finished items come out on the yellow spot in front. Each spot accepts loose items on the ground or any storage building sitting on it.</description>
    <thingClass>MendingMod.Building_AutomatedMender</thingClass>
    <!-- Without this the def defaults to TickerType.Never and Thing.DoTick never calls Tick(),
         so the mender's whole state machine (and its power draw) silently never runs. -->
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Production/AutomatedMender</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <size>(3,2)</size>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>0.3</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>AutomatedMending</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1500</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="MendingMod.CompProperties_MenderWasteBuffer">
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <toxicWasteDefName>Wastepack</toxicWasteDefName>
        <trashWasteDefNames>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
      </li>
    </comps>
  </ThingDef>

</Defs>
