    <label>electrical mending station</label>
    <description>A powered mending station. Repairs apparel and weapons four times as fast as working by hand, with no restriction on tech level or components. Runs warm while powered, so give it some ventilation.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableMending_Electric</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- CutoutComplex reads a companion mask, which the game looks for at
           <texPath>_northm / _eastm / _southm - an "m" appended with NO separating
           underscore (Graphic_Multi.Init builds it as path + "_north" + "m"). In that
           mask the slab is red, so it takes the stuff colour, and everything standing on
           the bench is black, so it keeps its own colours: a wooden bench still has steel
           tools on it. -->
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <costList>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <!-- Uninstall and reinstall, carrying the building's own state with it: a bench keeps its
         bill list, and the repair center drops whatever it was holding before it goes in the
         crate (see Building_AutomatedMender.DeSpawn). -->
    <minifiedDef>MinifiedThing</minifiedDef>
    <!-- Without hasInteractionCell, ThingUtility.InteractionCellWhenAt has no work spot to
         return for a multi-cell building, so the game draws no work-spot circle and the pawn
         ends up standing wherever it can touch the bench instead of in front of it. -->
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <!-- With no interactionCellIcon, GenDraw.DrawInteractionCell falls through to a plain
         marker plane; naming a def here makes it draw that def's BLUEPRINT graphic through the
         edge-detect shader instead, which is the chair ghost vanilla benches show. One field
         covers both cases - DrawInteractionCells is called from Designator_Place while placing
         and from Thing.DrawExtraSelectionOverlays while selected. It also draws nothing at all
         once a real sittable building stands on the cell, so the ghost disappears the moment
         the player puts an actual chair there. -->
    <interactionCellIcon>DiningChair</interactionCellIcon>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>45</Mass>
      <WorkTableWorkSpeedFactor>1.0</WorkTableWorkSpeedFactor>
      <WorkTableEfficiencyFactor>1.0</WorkTableEfficiencyFactor>
    </statBases>
    <researchPrerequisites>
      <li>ElectricMending</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>3</heatPerSecond>
        <heatPushMaxTemperature>32</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="MendingMod.CompProperties_MenderWasteBuffer">
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <toxicWasteDefName>Wastepack</toxicWasteDefName>
        <trashWasteDefNames>
          <li>VRecyclingE_Trash</li>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
        <trashWasteLabel>trash</trashWasteLabel>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>AutomatedMender</defName>
    <label>industrial repair center</label>
    <description>An industrial repair line that mends worn gear with no pawn labor. It always works as a skill 10 mender - never better, however good your crafters are - but that is its only limit: it will repair anything put in front of it, including gear your colony has no idea how to build. Select it to see its spots: it takes everything in on the side it faces - gear on the cyan port at the centre of that edge, materials either side of it and down both flanks - and finished items come out of the single port on the opposite edge. Put one damaged weapon or piece of apparel on the cyan spot, repair materials on any of the eight green spots, and collect repaired gear from the orange spot. Every spot accepts loose items on the ground or any storage building sitting on it. To feed it from a conveyor belt, build a mending feed port on the spot and point the belt at that - a belt aimed straight at the machine has nowhere to unload and will stall. Throws off serious heat while a repair is running, so it needs real cooling. Its waste container must be emptied when full, either by a hauler or with the dump command.</description>
    <thingClass>MendingMod.Building_AutomatedMender</thingClass>
    <!-- Without this the def defaults to TickerType.Never and Thing.DoTick never calls Tick(),
         so the mender's whole state machine (and its power draw) silently never runs. -->
    <tickerType>Normal</tickerType>
    <!-- Same shape of trap, one layer over: BuildingBase is MapMeshOnly, and
         Thing.DynamicDrawPhase does not call DrawAt on a MapMeshOnly thing at all - so the
         repair progress bar in Building_AutomatedMender.DrawAt never drew, with nothing logged
         to say why. MapMeshAndRealTime keeps the chassis printed into the map mesh and gets
         DrawAt called each frame; it does not double-draw the chassis, because Thing.DrawAt only
         draws the graphic itself when drawerType is RealtimeOnly. Vanilla's battery draws its
         charge bar exactly this way. -->
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/AutomatedMender</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- Matched to the largest of VFE Factory's own machines (they run 3x3 up to 5x5 and
           7x3). Five square holds all ten spots with a bay each once the material spots are
           spread around the perimeter - three down each flank, two either side of the item
           port on the back edge - rather than queued along the intake edge.

           drawSize is deliberately ONE CELL LARGER than size, which is what VFE do on every
           one of their machines: the art overhangs the footprint by half a cell all round and
           the ingress and egress bays live in that overhang, protruding out over the very
           cells items are placed on. Drawing at drawSize == size is what made this read as a
           small machine with cramped ports however large the footprint got. -->
      <drawSize>(6,6)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(5,5)</size>
    <costList>
      <Steel>250</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>4</ComponentSpacer>
      <!-- NOT THE WHOLE COST. MendingMod.MendingDefPatches appends a basic subcore to this list
           at StaticConstructorOnStartup, so what the game charges is this plus one subcore. It is
           done in C# rather than named here so the def is resolved against whatever this install
           actually has, instead of raising a config error where it does not exist. Anything
           reading this list before that static constructor runs will see the short version. The
           same file also attaches this building's research prerequisites. -->
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <surfaceType>Item</surfaceType>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <rotatable>true</rotatable>
    <!-- Uninstall and reinstall, carrying the building's own state with it: a bench keeps its
         bill list, and the repair center drops whatever it was holding before it goes in the
         crate (see Building_AutomatedMender.DeSpawn). -->
    <minifiedDef>MinifiedThing</minifiedDef>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <!-- Draws the input and output spots while the building is still on the cursor, so its
         orientation can be judged before it is committed. -->
    <placeWorkers>
      <li>MendingMod.PlaceWorker_MenderSpots</li>
    </placeWorkers>
    <statBases>
      <Mass>40</Mass>
      <Beauty>-8</Beauty>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>0.3</Flammability>
    </statBases>
    <researchPrerequisites>
      <li>AutomatedMending</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1750</basePowerConsumption>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>MendingMod.CompHeatPusherMending</compClass>
        <heatPerSecond>14</heatPerSecond>
        <heatPushMaxTemperature>60</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="MendingMod.CompProperties_MenderWasteBuffer">
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <toxicWasteDefName>Wastepack</toxicWasteDefName>
        <trashWasteDefNames>
          <li>VRecyclingE_Trash</li>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
        <trashWasteLabel>trash</trashWasteLabel>
      </li>
    </comps>
  </ThingDef>

</Defs>
