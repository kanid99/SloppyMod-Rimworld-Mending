<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>TableMending_Manual</defName>
    <label>hand mending station</label>
    <description>A simple, unpowered station for repairing worn apparel and weapons by hand. Hand tools only go so far: anything spacer-tier, and anything built around components, needs a powered station.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableMending_Manual</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- CutoutComplex reads a companion mask, which the game looks for at
           <texPath>_northm / _eastm / _southm - an "m" appended with NO separating
           underscore (Graphic_Multi.Init builds it as path + "_north" + "m"). In that
           mask the slab is red, so it takes the stuff colour, and everything standing on
           the bench is black, so it keeps its own colours: a wooden bench still has steel
           tools on it. -->
      <shaderType>CutoutComplex</shaderType>
      <!-- drawSize deliberately equals size: the textures are authored at the footprint's exact
           3:1 aspect, so the art lands inside its own cells with no overhang. -->
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <costList>
      <Steel>15</Steel>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <rotatable>true</rotatable>
    <!-- Uninstall and reinstall, carrying the building's own state with it: a bench keeps its
         bill list, and the repair center drops whatever it was holding before it goes in the
         crate (see Building_AutomatedMender.DeSpawn). -->
    <minifiedDef>MinifiedThing</minifiedDef>
    <!-- Without hasInteractionCell, ThingUtility.InteractionCellWhenAt has no work spot to
         return for a multi-cell building, so the game draws no work-spot circle and the pawn
         ends up standing wherever it can touch the bench instead of in front of it. -->
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <!-- With no interactionCellIcon, GenDraw.DrawInteractionCell falls through to a plain
         marker plane; naming a def here makes it draw that def's BLUEPRINT graphic through the
         edge-detect shader instead, which is the chair ghost vanilla benches show. One field
         covers both cases - DrawInteractionCells is called from Designator_Place while placing
         and from Thing.DrawExtraSelectionOverlays while selected. It also draws nothing at all
         once a real sittable building stands on the cell, so the ghost disappears the moment
         the player puts an actual chair there. -->
    <interactionCellIcon>DiningChair</interactionCellIcon>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>35</Mass>
      <WorkTableWorkSpeedFactor>0.25</WorkTableWorkSpeedFactor>
      <WorkTableEfficiencyFactor>1.0</WorkTableEfficiencyFactor>
    </statBases>
    <researchPrerequisites>
      <li>BasicMending</li>
    </researchPrerequisites>
    <!-- Hand tools only go so far: anything spacer-tier needs a powered station. An item with
         no declared tech level is judged by its materials instead (see GetEffectiveTechLevel). -->
    <modExtensions>
      <li Class="MendingMod.MendingTechLimitExtension">
        <maxTechLevel>Industrial</maxTechLevel>
        <allowComponents>false</allowComponents>
      </li>
    </modExtensions>
    <comps>
      <li Class="MendingMod.CompProperties_MenderWasteBuffer">
        <wasteBufferThreshold>1</wasteBufferThreshold>
        <toxicWasteDefName>Wastepack</toxicWasteDefName>
        <trashWasteDefNames>
          <li>VRecyclingE_Trash</li>
          <li>VRE_Trash</li>
          <li>VRE_TrashBag</li>
          <li>Trash</li>
        </trashWasteDefNames>
        <trashWasteLabel>trash</trashWasteLabel>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
